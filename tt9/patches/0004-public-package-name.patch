diff --git a/app/src/main/res/xml/prefs_screen_mode_abc.xml b/app/src/main/res/xml/prefs_screen_mode_abc.xml
index eb496897..99d304d1 100644
--- a/app/src/main/res/xml/prefs_screen_mode_abc.xml
+++ b/app/src/main/res/xml/prefs_screen_mode_abc.xml
