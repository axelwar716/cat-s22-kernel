diff --git a/app/version-tools.gradle b/app/version-tools.gradle
index 99fe5cd1..b7b42dd6 100644
--- a/app/version-tools.gradle
+++ b/app/version-tools.gradle
@@ -40,8 +40,8 @@ ext.exec = { command ->
 }
 
 // tt9-s22: fixed fork version (upstream v64.0 = versionCode 1645)
-static def s22VersionName() { return "64.0-s22.3" }
-static def s22VersionCode() { return 1650 }
+static def s22VersionName() { return "64.0-s22.4-pub" }
+static def s22VersionCode() { return 1651 }
 
 ext.getVersionName = { ->
 	return s22VersionName()
