 import io.github.sspanak.tt9.R;
 import io.github.sspanak.tt9.db.words.DictionaryLoader;
 import io.github.sspanak.tt9.ime.helpers.SuggestionOps;
+import io.github.sspanak.tt9.ime.helpers.InputConnectionAsync;
 import io.github.sspanak.tt9.ime.modes.InputModeKind;
 import io.github.sspanak.tt9.ui.UI;
 import io.github.sspanak.tt9.util.Text;
@@ -64,9 +65,14 @@ abstract public class SuggestionHandler extends TypingHandler {
 
 		suggestionOps.commitCurrent(false, true);
 		mInputMode.onAcceptSuggestion(lastWord, true);
+
+		// tt9-s22: in ABC mode, the text around the cursor was already read for this key press, and
+		// committing the composing letter does not change it, so reuse it instead of a 2nd blocking query.
+		final String[] cached = InputModeKind.isABC(mInputMode) && abcSurroundingChars != null && !InputConnectionAsync.TIMEOUT_SENTINEL.equals(abcSurroundingChars[0]) ? abcSurroundingChars : null;
+		abcSurroundingChars = null;
 		final String[] surroundingText = autoCorrectSpace(
 			lastWord,
-			textField.getSurroundingStringForAutoAssistance(settings, mInputMode),
+			cached != null ? cached : textField.getSurroundingStringForAutoAssistance(settings, mInputMode),
 			false,
 			mInputMode.getFirstKey()
 		);
@@ -147,7 +153,15 @@ abstract public class SuggestionHandler extends TypingHandler {
 	protected void handleSuggestionsAsync(double loadingId, @Nullable Runnable onComplete) {
 		final Handler handler = getAsyncHandler();
 		handler.removeCallbacksAndMessages(null);
-		handler.post(() -> handleSuggestions(loadingId, onComplete));
+
+		// tt9-s22: ABC mode computes its letters synchronously on the main thread. Posting the result
+		// for later allowed two queued key presses to be processed before it ran, and since the
+		// pending post is removed above, the first letter was lost ("the key did nothing").
+		if (InputModeKind.isABC(mInputMode) && Looper.myLooper() == Looper.getMainLooper()) {
+			handleSuggestions(loadingId, onComplete);
+		} else {
+			handler.post(() -> handleSuggestions(loadingId, onComplete));
+		}
 	}
 
 
diff --git a/app/src/main/java/io/github/sspanak/tt9/ime/TypingHandler.java b/app/src/main/java/io/github/sspanak/tt9/ime/TypingHandler.java
index 8a23d83f..106a56c7 100644
--- a/app/src/main/java/io/github/sspanak/tt9/ime/TypingHandler.java
+++ b/app/src/main/java/io/github/sspanak/tt9/ime/TypingHandler.java
@@ -44,6 +44,7 @@ public abstract class TypingHandler extends KeyPadHandler {
 	@NonNull protected CmdSuggestionPrevious cmdPreviousSuggestion = new CmdSuggestionPrevious();
 
 	@Nullable private Handler shiftStateDebounceHandler;
+	@Nullable protected String[] abcSurroundingChars = null; // tt9-s22: editor text read on the current key press
 
 	// input
 	@NonNull protected ArrayList<Integer> allowedInputModes = new ArrayList<>();
@@ -216,7 +217,13 @@ public abstract class TypingHandler extends KeyPadHandler {
 		suggestionOps.cancelDelayedAccept();
 
 		hold = hold && settings.getHoldToType();
-		String[] surroundingChars = textField.getSurroundingStringForAutoAssistance(settings, mInputMode);
+
+		// tt9-s22: when cycling the letters of the same key in ABC mode (multitap), the whole state
+		// (key, letter index, timer) lives in memory and the new letter only replaces the composing
+		// text. There is nothing to auto-space or auto-capitalize, so we must not query the editor:
+		// in slow apps that query blocks the main thread and makes key presses pile up.
+		final boolean isMultitapCycle = !hold && repeat > 0 && InputModeKind.isABC(mInputMode) && !suggestionOps.isEmpty();
+		String[] surroundingChars = isMultitapCycle ? new String[] {"", ""} : textField.getSurroundingStringForAutoAssistance(settings, mInputMode);
 		String lastWord = null;
 
 		// Automatically accept the previous word, when the next one is a space or punctuation,
@@ -234,8 +241,15 @@ public abstract class TypingHandler extends KeyPadHandler {
 			mindReader.setContext(mInputMode, mLanguage, surroundingChars, lastWord);
 		}
 
+		// tt9-s22: remember what we have just read, so that accepting the previous letter in ABC mode
+		// does not query the editor a second time for the same key press.
+		abcSurroundingChars = isMultitapCycle ? null : surroundingChars;
+
 		// Auto-adjust the text case before each word/char, if the InputMode supports it.
-		mInputMode.determineNextWordTextCase(surroundingChars[0], key);
+		// (Not in the middle of a multitap cycle: the letter case must stay the same.)
+		if (!isMultitapCycle) {
+			mInputMode.determineNextWordTextCase(surroundingChars[0], key);
+		}
 
 		if (!mInputMode.onNumber(key, hold, repeat, surroundingChars)) {
 			forceShowWindow();
@@ -251,11 +265,20 @@ public abstract class TypingHandler extends KeyPadHandler {
 			autoCompleteOnNumber(loadingId, surroundingChars, lastWord, key);
 			getSuggestions(loadingId, null, null);
 		}
+		abcSurroundingChars = null;
 
 		return true;
 	}
 
 
+	@Override
+	protected void onNumberKeyDown() {
+		if (InputModeKind.isABC(mInputMode)) {
+			suggestionOps.postponeDelayedAccept();
+		}
+	}
+
+
 	public boolean onText(String text, boolean validateOnly) {
 		if (mInputMode.shouldIgnoreText(text)) {
 			return false;
diff --git a/app/src/main/java/io/github/sspanak/tt9/ime/helpers/InputConnectionAsync.java b/app/src/main/java/io/github/sspanak/tt9/ime/helpers/InputConnectionAsync.java
index 9d2ac118..f8cff775 100644
--- a/app/src/main/java/io/github/sspanak/tt9/ime/helpers/InputConnectionAsync.java
+++ b/app/src/main/java/io/github/sspanak/tt9/ime/helpers/InputConnectionAsync.java
@@ -57,7 +57,10 @@ public class InputConnectionAsync {
 
 	private static ExecutorService getExecutor() {
 		if (executor == null || executor.isShutdown() || executor.isTerminated()) {
-			executor = Executors.newSingleThreadExecutor();
+			// tt9-s22: a cached pool instead of a single thread. When the editor does not answer,
+			// the timed-out binder call keeps occupying its thread; with a single thread every
+			// following query queued behind it and timed out too (cascading 50 ms main-thread stalls).
+			executor = Executors.newCachedThreadPool();
 		}
 
 		return executor;
diff --git a/app/src/main/java/io/github/sspanak/tt9/ime/helpers/SuggestionOps.java b/app/src/main/java/io/github/sspanak/tt9/ime/helpers/SuggestionOps.java
index 51c4aa0b..cb928c5d 100644
--- a/app/src/main/java/io/github/sspanak/tt9/ime/helpers/SuggestionOps.java
+++ b/app/src/main/java/io/github/sspanak/tt9/ime/helpers/SuggestionOps.java
@@ -26,6 +26,7 @@ import io.github.sspanak.tt9.util.sys.Clipboard;
 public class SuggestionOps {
 	@NonNull private final Handler delayedAcceptHandler;
 	@NonNull private final Consumer<String> onDelayedAccept;
+	private int pendingAcceptDelay = 0;
 
 	@Nullable protected SuggestionsBar suggestionBar;
 	@Nullable private AppHacks appHacks;
@@ -287,14 +288,30 @@ public class SuggestionOps {
 			onDelayedAccept.accept(acceptCurrent());
 			return true;
 		} else if (delay > 0) {
-			delayedAcceptHandler.postDelayed(() -> onDelayedAccept.accept(acceptCurrent()), delay);
+			pendingAcceptDelay = delay;
+			delayedAcceptHandler.postDelayed(() -> {
+				pendingAcceptDelay = 0;
+				onDelayedAccept.accept(acceptCurrent());
+			}, delay);
 		}
 
 		return false;
 	}
 
 
+	/**
+	 * tt9-s22: restart a pending auto-accept timer (if any), so that it counts from the latest real
+	 * key press (key down), instead of from the moment the previous key was processed.
+	 */
+	public void postponeDelayedAccept() {
+		if (pendingAcceptDelay > 0) {
+			scheduleDelayedAccept(pendingAcceptDelay);
+		}
+	}
+
+
 	public void cancelDelayedAccept() {
+		pendingAcceptDelay = 0;
 		delayedAcceptHandler.removeCallbacksAndMessages(null);
 	}
 
