@@ -5,13 +5,9 @@ import android.view.KeyEvent;
 import io.github.sspanak.tt9.ime.helpers.Key;
 import io.github.sspanak.tt9.preferences.screens.debug.DropDownInputHandlingMode;
 import io.github.sspanak.tt9.preferences.settings.SettingsStore;
-import io.github.sspanak.tt9.util.Timer;
 
 
 abstract class KeyPadHandler extends UiHandler {
-	// debounce handling
-	private final static String DEBOUNCE_TIMER = "debounce_";
-
 	// temporal key handling
 	private int ignoreNextKeyUp = 0;
 
@@ -69,6 +65,9 @@ abstract class KeyPadHandler extends UiHandler {
 
 		// start tracking key hold
 		if (Key.isNumber(keyCode)) {
+			// tt9-s22: the auto-accept timer must count from the last real key press. Holding the
+			// key down must not let the timer expire between DOWN and UP.
+			onNumberKeyDown();
 			event.startTracking();
 			return true;
 		}
@@ -190,6 +189,9 @@ abstract class KeyPadHandler extends UiHandler {
 	}
 
 
+	protected void onNumberKeyDown() {}
+
+
 	public void resetKeyRepeat() {
 		numKeyRepeatCounter = 0;
 		keyRepeatCounter = 0;
@@ -198,19 +200,28 @@ abstract class KeyPadHandler extends UiHandler {
 	}
 
 
+	/**
+	 * tt9-s22: the debounce window is measured between the event timestamps assigned by the kernel/
+	 * InputReader (event.getEventTime()), not between the moments we process the events. Otherwise,
+	 * when the main thread is briefly blocked (e.g. by a slow editor), queued key events are
+	 * processed back-to-back and real key presses get discarded.
+	 */
+	private final android.util.SparseArray<Long> lastKeyUpTime = new android.util.SparseArray<>();
+
 	private boolean debounceKey(int keyCode, KeyEvent event) {
-		if (settings.getKeyPadDebounceTime() <= 0 || event.isLongPress()) {
+		final int debounceTime = settings.getKeyPadDebounceTime();
+		if (debounceTime <= 0 || event.isLongPress()) {
 			return false;
 		}
 
-		String keyTimer = DEBOUNCE_TIMER + keyCode;
-
-		if (Timer.get(keyTimer) > 0 && Timer.get(keyTimer) < settings.getKeyPadDebounceTime()) {
+		final Long lastUp = lastKeyUpTime.get(keyCode);
+		final long elapsed = lastUp == null ? Long.MAX_VALUE : event.getEventTime() - lastUp;
+		if (elapsed >= 0 && elapsed < debounceTime) {
 			return true;
 		}
 
 		if (event.getAction() == KeyEvent.ACTION_UP) {
-			Timer.start(keyTimer);
+			lastKeyUpTime.put(keyCode, event.getEventTime());
 		}
 
 		return false;
diff --git a/app/src/main/java/io/github/sspanak/tt9/ime/SuggestionHandler.java b/app/src/main/java/io/github/sspanak/tt9/ime/SuggestionHandler.java
