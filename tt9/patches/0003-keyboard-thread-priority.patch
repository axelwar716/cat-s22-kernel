diff --git a/app/src/main/java/io/github/sspanak/tt9/util/sys/ThreadPriority.java b/app/src/main/java/io/github/sspanak/tt9/util/sys/ThreadPriority.java
new file mode 100644
index 00000000..31fa10b4
--- /dev/null
+++ b/app/src/main/java/io/github/sspanak/tt9/util/sys/ThreadPriority.java
@@ -0,0 +1,103 @@
+package io.github.sspanak.tt9.util.sys;
+
+import android.os.Process;
+
+import androidx.annotation.NonNull;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileReader;
+
+import io.github.sspanak.tt9.util.Logger;
+
+/**
+ * tt9-s22: system_server binds the keyboard without BIND_SCHEDULE_LIKE_TOP_APP, so Android keeps
+ * our process in the "background" scheduling group with all threads at nice 0, while the app
+ * being typed in (or being opened) runs its UI and render threads at nice -10. When the CPU is
+ * busy, for example while an app is starting, key handling and drawing the suggestion bar get
+ * only a small share of it and typing stalls.
+ * While the keyboard is visible, Android does schedule it like the top app, but as soon as it
+ * hides, ActivityManager resets the main thread to 0 and the RenderThread to -4. So, starting
+ * input in a new field, which happens before the keyboard is shown, always runs at low priority.
+ * Our UI and render threads get the same priority as the foreground app, no matter which app
+ * is on top, and we restore it after Android resets it. They sleep unless a key is being
+ * processed, so this costs nothing when not typing. Maintenance tasks, on the other hand, run
+ * below everything else.
+ */
+public class ThreadPriority {
+	private static final String LOG_TAG = ThreadPriority.class.getSimpleName();
+
+	/** Same as ActivityManager's TOP_APP_PRIORITY_BOOST for the UI and render threads of the top app. */
+	private static final int INTERACTIVE = -10;
+
+	private static int renderThreadId = 0;
+
+
+	/**
+	 * Call on the main thread. The RenderThread only exists after the first window has been drawn,
+	 * so until then only the main thread is boosted. Threads that already have the right priority
+	 * are skipped, so this is cheap enough to call on every input field.
+	 */
+	public static void boostUiThreads() {
+		boost(Process.myTid(), "main");
+
+		if (renderThreadId == 0) {
+			renderThreadId = findThread("RenderThread");
+		}
+		if (renderThreadId > 0 && !boost(renderThreadId, "RenderThread")) {
+			renderThreadId = 0;
+		}
+	}
+
+
+	private static boolean boost(int tid, @NonNull String name) {
+		try {
+			return Process.getThreadPriority(tid) == INTERACTIVE || set(tid, INTERACTIVE, name);
+		} catch (Exception e) {
+			return false;
+		}
+	}
+
+
+	private static int findThread(@NonNull String name) {
+		final File[] tasks = new File("/proc/self/task").listFiles();
+		if (tasks == null) {
+			return 0;
+		}
+
+		for (File task : tasks) {
+			try (BufferedReader reader = new BufferedReader(new FileReader(new File(task, "comm")))) {
+				if (name.equals(reader.readLine())) {
+					return Integer.parseInt(task.getName());
+				}
+			} catch (Exception ignored) {}
+		}
+
+		return 0;
+	}
+
+
+	/** Runs the task on the current thread at background priority, then restores the previous one. */
+	public static void runInBackground(@NonNull Runnable task) {
+		final int tid = Process.myTid();
+		final int previous = Process.getThreadPriority(tid);
+		set(tid, Process.THREAD_PRIORITY_BACKGROUND, "maintenance");
+		try {
+			task.run();
+		} finally {
+			set(tid, previous, "maintenance");
+		}
+	}
+
+
+	private static boolean set(int tid, int priority, @NonNull String name) {
+		try {
+			Process.setThreadPriority(tid, priority);
+			Logger.d(LOG_TAG, "Thread " + name + " (" + tid + ") priority: " + priority);
+			return true;
+		} catch (Exception e) {
+			Logger.w(LOG_TAG, "Could not set priority " + priority + " for thread " + name + " (" + tid + "). " + e.getMessage());
+			return false;
+		}
+	}
+}
