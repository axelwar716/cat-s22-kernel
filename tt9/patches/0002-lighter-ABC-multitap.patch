 		return connection != null ? run(isUs, () -> connection.getTextAfterCursor(length, flags), TaskType.GET_TEXT_AFTER_CURSOR) : null;
 	}
 
+	/**
+	 * tt9-s22: reads the text before and after the cursor with two concurrent requests, instead of
+	 * one after the other. Each one blocks the main thread until the app answers, so on slow devices
+	 * this saves a full round trip to the app on every new letter. The results, timeouts and
+	 * failures are the same as calling getTextBeforeCursor() and getTextAfterCursor() in a row.
+	 *
+	 * @return [0] = text before the cursor, [1] = text after the cursor; null elements on failure.
+	 */
+	public static CharSequence[] getTextAroundCursor(boolean isUs, InputConnection connection, int beforeLength, int afterLength, int flags) {
+		if (connection == null) {
+			return new CharSequence[] { null, null };
+		}
+
+		if (isUs) {
+			return new CharSequence[] {
+				runSync(() -> connection.getTextBeforeCursor(beforeLength, flags)),
+				runSync(() -> connection.getTextAfterCursor(afterLength, flags))
+			};
+		}
+
+		final Future<CharSequence> before = submit(() -> connection.getTextBeforeCursor(beforeLength, flags), TaskType.GET_TEXT_BEFORE_CURSOR);
+		final Future<CharSequence> after = submit(() -> connection.getTextAfterCursor(afterLength, flags), TaskType.GET_TEXT_AFTER_CURSOR);
+
+		return new CharSequence[] {
+			await(before, TaskType.GET_TEXT_BEFORE_CURSOR),
+			await(after, TaskType.GET_TEXT_AFTER_CURSOR)
+		};
+	}
+
 	public static ExtractedText getExtractedText(boolean isUs, InputConnection connection, ExtractedTextRequest request, int flags) {
 		return connection != null ? run(isUs, () -> connection.getExtractedText(request, flags), TaskType.GET_EXTRACTED_TEXT) : null;
 	}
@@ -73,7 +102,26 @@ public class InputConnectionAsync {
 
 
 	private static <T> T runAsync(Callable<T> task, TaskType type) {
-		Future<T> future = getExecutor().submit(task);
+		return await(submit(task, type), type);
+	}
+
+
+	@Nullable
+	private static <T> Future<T> submit(Callable<T> task, TaskType type) {
+		try {
+			return getExecutor().submit(task);
+		} catch (Exception e) {
+			Logger.w(LOG_TAG, type.name() + " failed. " + e);
+			return null;
+		}
+	}
+
+
+	private static <T> T await(@Nullable Future<T> future, TaskType type) {
+		if (future == null) {
+			return null;
+		}
+
 		try {
 			return future.get(SettingsStore.INPUT_CONNECTION_MAX_WAIT, TimeUnit.MILLISECONDS);
 		} catch (TimeoutException e) {
